{
  "name": "flow-agent",
  "version": "0.1.0",
  "description": "A voice-native dev agent. Dictate with Wispr Flow, interrupt it mid-task, and it re-plans.",
  "type": "module",
  "bin": {
    "flow-agent": "bin/flow-agent.js"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test test/*.test.ts",
    "test:demo": "npm --prefix demo/todo-app test",
    "typecheck": "tsc --noEmit",
    "dictation-log": "tsx scripts/dictation-log.ts",
    "record-replay": "tsx scripts/record-replay.ts"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "tsx": "^4.19.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
