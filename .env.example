# Which model provider to use: gemini (free), groq (free), ollama (local, free), or openai-compatible
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey (no card needed). For groq: https://console.groq.com/keys. Not needed for ollama.
LLM_API_KEY=
# Optional overrides
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=
# Backup models to use when the main one is overloaded (comma separated). Found automatically if empty.
# LLM_FALLBACK_MODELS=

# Optional second provider with its own free quota. If the main one stops answering, requests switch
# to it for a few minutes. Recommended for recording a demo: LLM_PROVIDER=groq with gemini as backup.
# LLM_BACKUP_PROVIDER=gemini
# LLM_BACKUP_API_KEY=
# LLM_BACKUP_MODEL=
# Set to 0 to skip the one tiny warm-up request sent at startup.
# WARMUP=1

# Folder the agent works on (defaults to the folder you start it from)
# WORKSPACE=C:\Users\you\code\my-project
PORT=4242

# Optional: lets "open a pull request" create the PR itself. Without it (and without the gh CLI),
# the branch is still pushed and Flow Agent hands you the GitHub page to open it in one click.
# Create one at https://github.com/settings/tokens?type=beta with "Pull requests: read and write".
# GITHUB_TOKEN=

# Optional, for `npm run demo`: an empty GitHub repo of yours (e.g. https://github.com/you/todo-app-demo).
# The demo clones it (seeding it with the todo app the first time), so "open a PR" opens a real one.
# DEMO_REPO=
