# Which model provider to use: gemini (free tier), groq (free tier), ollama (local, free), or openai-compatible
LLM_PROVIDER=gemini
# Free key from https://aistudio.google.com/apikey (no card needed). Not needed for ollama.
LLM_API_KEY=
# Optional overrides
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=

# Folder the agent works on (defaults to the folder you start it from)
# WORKSPACE=C:\Users\you\code\my-project
PORT=4242
