# Which model provider to use: groq (free, fastest), gemini (free), ollama (local, free), or openai-compatible
LLM_PROVIDER=groq
# Free key from https://console.groq.com/keys (no card needed). For gemini: https://aistudio.google.com/apikey. Not needed for ollama.
LLM_API_KEY=
# Optional overrides
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=
# Backup models to use when the main one is overloaded (comma separated). Found automatically if empty.
# LLM_FALLBACK_MODELS=

# Folder the agent works on (defaults to the folder you start it from)
# WORKSPACE=C:\Users\you\code\my-project
PORT=4242
